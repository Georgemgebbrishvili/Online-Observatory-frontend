{
  "name": "darkview-clients",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @darkview/web",
    "build": "npm run build --workspace @darkview/web",
    "start": "npm run start --workspace @darkview/web",
    "lint": "eslint . && stylelint \"apps/web/src/**/*.css\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @darkview/web",
    "contracts:generate": "node scripts/contracts-generate.mjs",
    "contracts:check": "node scripts/contracts-check.mjs",
    "contracts:sync": "node scripts/contracts-sync.mjs"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "typescript": "6.0.3"
  }
}
