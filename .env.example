# Stellar clients — the website and the mobile application.
#
# This repository is the client half. It holds no secret: no database URL, no auth
# secret, no payment key, no observatory credential. Everything server-side arrives
# over HTTPS from darkview-platform. These are the only variables it reads.

# The platform API. In production the reverse proxy serves it same-origin at /api
# (ADR-016 §4); in development next.config.ts rewrites /api here.
DARKVIEW_PLATFORM_API_URL=http://127.0.0.1:4000

# This app's own public origin, used for canonical URLs and Open Graph metadata.
APP_URL=http://localhost:3000

# Optional. Enables the safe-nudge control in the live room.
NEXT_PUBLIC_ENABLE_SAFE_NUDGE=
