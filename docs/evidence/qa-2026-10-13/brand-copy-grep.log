=== 6. Georgian guard
html[lang="ka"] body {
  line-height: var(--leading-body-georgian);
}

html[lang="ka"] :is(h1, h2, h3, h4, .button, .eyebrow, .kicker) {
  overflow-wrap: anywhere;
}

/* Brand §05: Mkhedruli is not a case-based script — never uppercase or letter-space Georgian. */
:lang(ka) {
  letter-spacing: normal !important;
  text-transform: none !important;
}

:lang(ka) {
  /* Georgian first, so a Latin word in a Georgian headline keeps the same voice and no
     system fallback for Anton can catch a Mkhedruli letter. */
  --font-headline: var(--font-noto-sans-georgian), sans-serif;
  --font-title: var(--font-noto-sans-georgian), sans-serif;
  --font-label: var(--font-noto-sans-georgian), sans-serif;
  --font-weight-headline: var(--font-weight-heavy);
  --font-weight-title: var(--font-weight-black);
  --font-weight-label: var(--font-weight-semibold);
}
